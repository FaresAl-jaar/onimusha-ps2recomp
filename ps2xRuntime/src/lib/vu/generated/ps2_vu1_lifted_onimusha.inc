template <>
int VU1Lifted::runImage<10>(VU1Interpreter &vu, LiftedRun &run, uint32_t startPc)
{
    BranchBackup bk{};
    // VF/VI/ACC live in locals (memory stores cannot alias them); written back on every exit
    // and spilled before the interpreter functions that read them.
    alignas(16) float lvf[32][4];
    int32_t lvi[16];
    alignas(16) float lacc[4];
    std::memcpy(lvf, vu.m_state.vf, sizeof(lvf));
    std::memcpy(lvi, vu.m_state.vi, sizeof(lvi));
    std::memcpy(lacc, vu.m_state.acc, sizeof(lacc));
    auto spillVf = [&]() { std::memcpy(vu.m_state.vf, lvf, sizeof(lvf)); std::memcpy(vu.m_state.acc, lacc, sizeof(lacc)); };
    auto writeBack = [&]() { spillVf(); std::memcpy(vu.m_state.vi, lvi, sizeof(lvi)); };
    uint8_t *const mem = run.mem;
    const uint32_t dm = run.dataMask;
    (void)mem;
    (void)dm;
    switch (startPc)
    {
    case 0x0000: goto B_0000;
    case 0x00E0: goto B_00E0;
    case 0x0100: goto B_0100;
    case 0x01A0: goto B_01A0;
    case 0x01F8: goto B_01F8;
    case 0x0280: goto B_0280;
    case 0x0298: goto B_0298;
    case 0x02A0: goto B_02A0;
    case 0x02C8: goto B_02C8;
    case 0x0320: goto B_0320;
    case 0x03B0: goto B_03B0;
    case 0x03B8: goto B_03B8;
    case 0x03D0: goto B_03D0;
    case 0x03E8: goto B_03E8;
    default: return kLiftNotLifted;
    }

B_0000:
    if (vu.m_cycle >= run.budgetEnd)
    { writeBack(); return yield(vu, bk, 0x0000u); }
