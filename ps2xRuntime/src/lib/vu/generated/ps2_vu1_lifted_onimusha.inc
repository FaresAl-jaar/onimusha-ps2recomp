// MAC/status are computed for 3 of 83 FMAC ops (the rest cannot be observed by FMAND & co.).
constexpr bool kLiftedFlagsExact = false;

static bool isBlockStart(uint32_t pc)
{
    switch (pc)
    {
    case 0x0000:
    case 0x0090:
    case 0x00B8:
    case 0x00E0:
    case 0x0100:
    case 0x0138:
    case 0x01B8:
    case 0x01C8:
    case 0x01D8:
    case 0x01F0:
        return true;
    default:
        return false;
    }
}


